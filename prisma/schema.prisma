generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Debate stats
  wins         Int     @default(0)
  losses       Int     @default(0)
  draws        Int     @default(0)
  totalDebates Int     @default(0)
  avgScore     Float   @default(0)

  accounts Account[]
  sessions Session[]
  debates  Debate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Debate {
  id          String    @id @default(cuid())
  userId      String
  topic       String    @db.Text
  userSide    String
  aiSide      String
  totalRounds Int       @default(5)
  status      String    @default("in_progress")
  result      String?
  userScore   Float?
  aiScore     Float?
  difficulty  String    @default("medium")
  summary     String?   @db.Text
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds Round[]

  @@index([userId])
  @@index([status])
}

model Round {
  id             String  @id @default(cuid())
  debateId       String
  roundNumber    Int
  userArgument   String? @db.Text
  aiArgument     String? @db.Text
  userRoundScore Float?
  aiRoundScore   Float?
  feedback       String? @db.Text

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([debateId, roundNumber])
  @@index([debateId])
}