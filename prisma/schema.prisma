generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// --------------------------------
// Auth Tables (NextAuth)
// --------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  debates       Debate[]
  scores        Score[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------
// Debate Tables
// --------------------------------

model Debate {
  id        String      @id @default(cuid())
  topic     String
  status    DebateStatus @default(ONGOING)
  winner    String?     // "human" | "ai"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds    Round[]
  score     Score?
}

model Round {
  id            String   @id @default(cuid())
  roundNumber   Int
  humanArgument String   @db.Text
  aiArgument    String   @db.Text
  createdAt     DateTime @default(now())
  debateId      String
  debate        Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@unique([debateId, roundNumber]) // prevent duplicate rounds
}

model Score {
  id         String   @id @default(cuid())
  won        Boolean
  humanScore Int      // out of 100
  aiScore    Int      // out of 100
  feedback   String   @db.Text
  createdAt  DateTime @default(now())
  userId     String
  debateId   String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debate     Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
}

// --------------------------------
// Enums
// --------------------------------

enum DebateStatus {
  ONGOING
  FINISHED
}